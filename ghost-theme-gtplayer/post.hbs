{{!< default}}

{{#post}}
<article class="post-full {{post_class}}">

  <div class="post-header">
    <div class="post-header-inner">
      <div class="post-eyebrow">DAILY GAME INTELLIGENCE</div>
      <h1 class="post-title">{{title}}</h1>
      <div class="post-meta-bar">
        <time class="lang-ko-only" id="postDateKo" datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY년 MM월 DD일 (ddd)"}}</time>
        <time class="lang-en-only" id="postDateEn" datetime="{{date format="YYYY-MM-DD"}}" style="display:none">{{date format="MMM DD, YYYY (ddd)"}}</time>
        <time class="lang-ja-only" id="postDateJa" datetime="{{date format="YYYY-MM-DD"}}" style="display:none">{{date format="YYYY年 MM月 DD日 (ddd)"}}</time>
        {{#if primary_tag}}<span class="meta-sep">·</span><span>{{primary_tag.name}}</span>{{/if}}
        <span class="meta-sep">·</span><span id="postReadingTime" data-mins="{{reading_time minute="%" minutes="%"}}">{{reading_time minute="%" minutes="%"}}분 읽기</span>
      </div>
    </div>
  </div>

  <section class="post-content">
    {{content}}
  </section>


  <!-- POST SHARE -->
  <div class="post-share">
    <span class="share-label" id="shareLabelText">공유하기</span>
    <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute='true'}}" target="_blank" rel="noopener" class="share-btn share-twitter" title="Share on X">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute='true'}}" target="_blank" rel="noopener" class="share-btn share-facebook" title="Share on Facebook">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
    </a>
    <button class="share-btn share-link" title="Copy Link" id="copyLinkBtn" data-url="{{url absolute='true'}}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
    </button>
  </div>

  <!-- POST NAV (Client-side localized & language-bound) -->
  <nav class="post-nav" id="customPostNav" style="display:none;">
    <a class="post-nav-link prev" id="customPrevLink" href="#" style="visibility:hidden;">
      <span class="post-nav-label" id="postPrevLabel">← 이전</span>
      <span class="post-nav-title" id="customPrevTitle">Title</span>
    </a>
    <a class="post-nav-link next" id="customNextLink" href="#" style="visibility:hidden;">
      <span class="post-nav-label" id="postNextLabel">다음 →</span>
      <span class="post-nav-title" id="customNextTitle">Title</span>
    </a>
  </nav>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var key = window.__GHOST_CONTENT_KEY;
    if (!key) return;


    var currentLang = 'ko';
    var bodyClass = document.body.className;
    if (bodyClass.indexOf('tag-hash-lang-en') !== -1) currentLang = 'en';
    else if (bodyClass.indexOf('tag-hash-lang-ja') !== -1) currentLang = 'ja';

    // Share Text I18n
    var shareTexts = { 'ko': '공유하기', 'en': 'Share', 'ja': '共有する' };
    var copySuccess = { 'ko': '링크가 복사되었습니다!', 'en': 'Link copied!', 'ja': 'リンクをコピーしました！' };
    var copyBtn = document.getElementById('copyLinkBtn');
    if (document.getElementById('shareLabelText')) {
        document.getElementById('shareLabelText').textContent = shareTexts[currentLang];
    }
    if (copyBtn) {
        copyBtn.addEventListener('click', function() {
            var url = this.getAttribute('data-url');
            navigator.clipboard.writeText(url).then(function() {
                alert(copySuccess[currentLang]);
            });
        });
    }


    var tagFilter = 'tag:hash-lang-' + currentLang;
    var currentSlug = "{{slug}}";

    fetch('/ghost/api/content/posts/?key=' + key + '&filter=' + tagFilter + '&limit=all&order=published_at%20desc&fields=title,url,slug')
      .then(function(r) { return r.json(); }).then(function(data) {
        if (!data || !data.posts) return;
        var posts = data.posts;
        var idx = -1;
        for (var i = 0; i < posts.length; i++) {
          if (posts[i].slug === currentSlug) { idx = i; break; }
        }
        if (idx !== -1) {
          // Prev post is older chronologically, so it's idx + 1 in a desc list
          if (idx + 1 < posts.length) {
            var prevP = posts[idx + 1];
            document.getElementById('customPrevLink').href = prevP.url;
            document.getElementById('customPrevTitle').textContent = prevP.title;
            document.getElementById('customPrevLink').style.visibility = 'visible';
          }
          // Next post is newer chronologically, so it's idx - 1 in a desc list
          if (idx - 1 >= 0) {
            var nextP = posts[idx - 1];
            document.getElementById('customNextLink').href = nextP.url;
            document.getElementById('customNextTitle').textContent = nextP.title;
            document.getElementById('customNextLink').style.visibility = 'visible';
          }
          if (idx + 1 < posts.length || idx - 1 >= 0) {
            document.getElementById('customPostNav').style.display = 'flex';
          }
        }
      }).catch(function(e) { console.error(e); });
  });
  </script>

  <div class="post-subscribe">
    <h3 id="postSubTitle">GTPlayer 뉴스레터 구독하기</h3>
    <p id="postSubDesc">게임 산업 인사이트를 매일 아침 7시에 받아보세요.</p>
    <a href="#/portal/signup" class="btn-sub-lg" data-portal="signup" id="postSubBtn">무료 구독 →</a>
  </div>

</article>
{{/post}}
