  "raw_html": {
    "ko": "<div style=\"padding:28px 0 20px;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 01</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#1f2937;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid #f0f4f8;\">📅 게임 캘린더</h2>\n\n  <div style=\"font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;\">이번 주 출시</div>\n\n  <!-- 출시 게임 1 -->\n  <div style=\"background:#f9fafb;border-radius:10px;padding:14px 18px;border-left:3px solid #10b981;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;\">\n    <div>\n      <div style=\"font-size:14px;font-weight:700;color:#111827;\">Elden Ring: Nightreign</div>\n      <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">FromSoftware &nbsp;·&nbsp; 3월 16일(일)</div>\n    </div>\n    <div>\n      <span style=\"background:#dbeafe;color:#1d4ed8;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">PC</span>&nbsp;\n      <span style=\"background:#ede9fe;color:#6d28d9;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">PS5</span>&nbsp;\n      <span style=\"background:#ede9fe;color:#6d28d9;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">Xbox</span>\n    </div>\n  </div>\n\n  <!-- 출시 게임 2 -->\n  <div style=\"background:#f9fafb;border-radius:10px;padding:14px 18px;border-left:3px solid #6366f1;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;\">\n    <div>\n      <div style=\"font-size:14px;font-weight:700;color:#111827;\">Blue Protocol: Resonance</div>\n      <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">Bandai Namco &nbsp;·&nbsp; 3월 18일(화) 글로벌 동시 출시</div>\n    </div>\n    <div>\n      <span style=\"background:#dcfce7;color:#15803d;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">Mobile</span>&nbsp;\n      <span style=\"background:#dbeafe;color:#1d4ed8;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">PC</span>\n    </div>\n  </div>\n\n  <!-- 출시 게임 3 -->\n  <div style=\"background:#f9fafb;border-radius:10px;padding:14px 18px;border-left:3px solid #f59e0b;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;\">\n    <div>\n      <div style=\"font-size:14px;font-weight:700;color:#111827;\">Final Fantasy XVII <span style=\"font-size:11px;font-weight:400;color:#6b7280;\">얼리 액세스</span></div>\n      <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">Square Enix &nbsp;·&nbsp; 3월 20일(목)</div>\n    </div>\n    <div>\n      <span style=\"background:#dbeafe;color:#1d4ed8;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">PC</span>&nbsp;\n      <span style=\"background:#ede9fe;color:#6d28d9;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">PS5</span>\n    </div>\n  </div>\n\n  <div style=\"font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;\">주요 이벤트</div>\n  <div style=\"background:#fff7ed;border-radius:10px;padding:14px 18px;border-left:3px solid #f97316;display:flex;justify-content:space-between;align-items:center;\">\n    <div>\n      <div style=\"font-size:14px;font-weight:700;color:#111827;\">G-Star 2026 <span style=\"font-size:11px;font-weight:400;color:#6b7280;\">개최 확정</span></div>\n      <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">부산 BEXCO &nbsp;·&nbsp; 11월 13일 ~ 16일</div>\n    </div>\n    <div>\n      <span style=\"background:#fed7aa;color:#c2410c;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;\">KR 이벤트</span>\n    </div>\n  </div>\n</div>\n\n<hr style=\"border:none;border-top:2px solid #f0f4f8;margin:24px 0;\">\n\n\n\n<div style=\"padding:20px 0;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 02</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#1f2937;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid #e5e7eb;\">📰 오늘의 게임 브리핑</h2>\n\n  <!-- 뉴스 1 -->\n  <div style=\"margin-bottom:14px;border-bottom:1px solid #e5e7eb;padding-bottom:14px;display:flex;align-items:flex-start;gap:12px;\">\n    <span style=\"background:#dcfce7;color:#15803d;font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;white-space:nowrap;\">출시</span>\n    <div>\n      <div style=\"font-size:14px;font-weight:600;color:#111827;line-height:1.4;\">G-Star 2026, 부산 벡스코 11월 개최 공식 확정 — 역대 최대 규모, 글로벌 50개사 참여 예정</div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:4px;\">인벤 &nbsp;·&nbsp; 2시간 전</div>\n    </div>\n  </div>\n\n  <!-- 뉴스 2 -->\n  <div style=\"margin-bottom:14px;border-bottom:1px solid #e5e7eb;padding-bottom:14px;display:flex;align-items:flex-start;gap:12px;\">\n    <span style=\"background:#dbeafe;color:#1e40af;font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;white-space:nowrap;\">업데이트</span>\n    <div>\n      <div style=\"font-size:14px;font-weight:600;color:#111827;line-height:1.4;\">League of Legends 2026 시즌 개편 공개 — 랭크 시스템 전면 재설계와 신규 챔피언 2종 동시 출시</div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:4px;\">게임메카 &nbsp;·&nbsp; 4시간 전</div>\n    </div>\n  </div>\n\n  <!-- 뉴스 3 -->\n  <div style=\"margin-bottom:14px;border-bottom:1px solid #e5e7eb;padding-bottom:14px;display:flex;align-items:flex-start;gap:12px;\">\n    <span style=\"background:#fee2e2;color:#b91c1c;font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;white-space:nowrap;\">할인</span>\n    <div>\n      <div style=\"font-size:14px;font-weight:600;color:#111827;line-height:1.4;\">Steam 스프링 세일 시작 — 인기 타이틀 최대 90% 할인, Monster Hunter Wilds -40%</div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:4px;\">Steam &nbsp;·&nbsp; 오늘 00:00 ~ 3월 21일</div>\n    </div>\n  </div>\n\n  <!-- 뉴스 4 -->\n  <div style=\"margin-bottom:14px;border-bottom:1px solid #e5e7eb;padding-bottom:14px;display:flex;align-items:flex-start;gap:12px;\">\n    <span style=\"background:#fef9c3;color:#854d0e;font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;white-space:nowrap;\">인사이동</span>\n    <div>\n      <div style=\"font-size:14px;font-weight:600;color:#111827;line-height:1.4;\">Hideo Kojima, Sony와 공동 투자로 신규 스튜디오 'VOID Productions' 설립 공식 발표</div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:4px;\">Polygon &nbsp;·&nbsp; 6시간 전</div>\n    </div>\n  </div>\n\n  <!-- 뉴스 5 -->\n  <div style=\"display:flex;align-items:flex-start;gap:12px;\">\n    <span style=\"background:#ede9fe;color:#6d28d9;font-size:9px;font-weight:700;padding:3px 8px;border-radius:4px;white-space:nowrap;\">펀딩</span>\n    <div>\n      <div style=\"font-size:14px;font-weight:600;color:#111827;line-height:1.4;\">크래프톤, 인도 모바일 게임 시장 공략 위해 현지 스튜디오에 300억 원 투자 확정</div>\n      <div style=\"font-size:11px;color:#9ca3af;margin-top:4px;\">파이낸셜뉴스 &nbsp;·&nbsp; 8시간 전</div>\n    </div>\n  </div>\n</div>\n\n<hr style=\"border:none;border-top:2px solid #f0f4f8;margin:24px 0;\">\n\n\n\n<div style=\"padding:20px 0;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 03</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#1f2937;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid #f0f4f8;\">👥 신작 유저 피드백 분석</h2>\n\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;\">\n    <div>\n      <div style=\"font-size:17px;font-weight:800;color:#111827;\">Elden Ring: Nightreign</div>\n      <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">출시 1주차 &nbsp;·&nbsp; 수집 리뷰 12,847건 (인벤, Steam, Reddit)</div>\n    </div>\n    <div style=\"background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:8px 16px;text-align:center;\">\n      <div style=\"font-size:9px;color:#15803d;font-weight:700;letter-spacing:1px;\">종합 점수</div>\n      <div style=\"font-size:24px;font-weight:900;color:#15803d;line-height:1.1;\">4.2</div>\n      <div style=\"font-size:10px;color:#6b7280;\">/5.0</div>\n    </div>\n  </div>\n\n  <!-- 감성 바 -->\n  <div style=\"margin-bottom:18px;\">\n    <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:9px;\">\n      <span style=\"font-size:11px;color:#374151;width:50px;\">긍정적</span>\n      <div style=\"flex:1;background:#e5e7eb;border-radius:100px;height:9px;\"><div style=\"background:#10b981;width:74%;height:9px;border-radius:100px;\"></div></div>\n      <span style=\"font-size:12px;font-weight:800;color:#10b981;width:36px;text-align:right;\">74%</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:9px;\">\n      <span style=\"font-size:11px;color:#374151;width:50px;\">중립</span>\n      <div style=\"flex:1;background:#e5e7eb;border-radius:100px;height:9px;\"><div style=\"background:#f59e0b;width:16%;height:9px;border-radius:100px;\"></div></div>\n      <span style=\"font-size:12px;font-weight:800;color:#f59e0b;width:36px;text-align:right;\">16%</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:8px;\">\n      <span style=\"font-size:11px;color:#374151;width:50px;\">부정적</span>\n      <div style=\"flex:1;background:#e5e7eb;border-radius:100px;height:9px;\"><div style=\"background:#ef4444;width:10%;height:9px;border-radius:100px;\"></div></div>\n      <span style=\"font-size:12px;font-weight:800;color:#ef4444;width:36px;text-align:right;\">10%</span>\n    </div>\n  </div>\n\n  <!-- 키워드 -->\n  <div style=\"margin-bottom:16px;\">\n    <span style=\"background:#dcfce7;color:#15803d;border-radius:100px;font-size:11px;font-weight:600;padding:4px 12px;display:inline-block;margin:3px 3px 3px 0;\">🎯 전투 시스템 혁신</span>\n    <span style=\"background:#dcfce7;color:#15803d;border-radius:100px;font-size:11px;font-weight:600;padding:4px 12px;display:inline-block;margin:3px 3px 3px 0;\">🌍 오픈월드 방대함</span>\n    <span style=\"background:#dcfce7;color:#15803d;border-radius:100px;font-size:11px;font-weight:600;padding:4px 12px;display:inline-block;margin:3px 3px 3px 0;\">✨ 그래픽 최고 수준</span>\n    <span style=\"background:#fee2e2;color:#b91c1c;border-radius:100px;font-size:11px;font-weight:600;padding:4px 12px;display:inline-block;margin:3px 3px 3px 0;\">⚠ 초반 최적화 이슈</span>\n    <span style=\"background:#fee2e2;color:#b91c1c;border-radius:100px;font-size:11px;font-weight:600;padding:4px 12px;display:inline-block;margin:3px 3px 3px 0;\">🐛 초반 로딩 시간 급등</span>\n  </div>\n\n  <!-- 유저 코멘트 -->\n  <div style=\"background:#f9fafb;border-radius:10px;padding:16px 18px;border-left:3px solid #10b981;margin-bottom:8px;\">\n    <div style=\"font-size:13px;color:#374151;line-height:1.6;\">\"역대 FromSoftware 최고의 멀티플레이어 경험. 전투 시스템이 완전히 새로운 수준을 보여줬다. 1000시간은 가뿐히 할 것 같다.\"</div>\n    <div style=\"font-size:10px;color:#9ca3af;margin-top:6px;\">Steam 리뷰 · 플레이 시간 87시간 · 매우 추천</div>\n  </div>\n  <div style=\"background:#f9fafb;border-radius:10px;padding:16px 18px;border-left:3px solid #ef4444;\">\n    <div style=\"font-size:13px;color:#374151;line-height:1.6;\">\"보스전 배경인데 RTX 4090에서도 60프레임이 불안하다. 최적화 패치 없으면 평가가 못 올라갈 것 같다.\"</div>\n    <div style=\"font-size:10px;color:#9ca3af;margin-top:6px;\">Reddit r/eldenring · 매우 비판적</div>\n  </div>\n</div>\n\n<hr style=\"border:none;border-top:2px solid #f0f4f8;margin:24px 0;\">\n\n\n\n<div style=\"background:#f0fdf4;border-radius:12px;padding:28px 24px;margin:20px 0;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 04</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#1f2937;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid #d1fae5;\">✍️ Dr. K 코멘트</h2>\n\n  <div style=\"font-size:15px;font-weight:700;color:#111827;margin-bottom:12px;\">AI가 게임 개발의 문을 열고 있다 — 기회인가, 위기인가?</div>\n  <div style=\"font-size:13px;color:#374151;line-height:1.9;margin-bottom:16px;\">\n    이번 주 넥슨이 'AI 스튜디오'를 공개하면서, 업계에서 조용히 진행되던 흐름이 수면 위로 올라왔습니다. AI가 NPC 대화를 쓰고, 배경 아트를 생성하고, 사운드를 알아서 디자인하는 시대. 이것은 단순한 위기이기보다는 <strong>창의의 혁명</strong>이라고 봅니다.\n  </div>\n\n  <div style=\"background:#ffffff;border-radius:10px;padding:20px 22px;border:1px solid #d1fae5;font-size:13px;color:#374151;line-height:1.9;\">\n    이전에는 AAA 스튜디오만이 할 수 있던 것들을 이제 인디 개발자 한 사람도 할 수 있게 됩니다. 진짜 경쟁은 이제 시작입니다.<br><br>\n    하지만 AI가 모든 것을 해결하는 것은 아닙니다. <strong>플레이어가 왜 게임에 감동받는지</strong>를 아는 것, 데이터는 '무엇을'만 알려주지만 '왜'는 사람의 영역입니다.<br><br>\n    결국 살아남는 게임사는 AI를 두려워하는 곳이 아닙니다. AI를 가장 잘 활용하는 도구로서 이해하고 있는 곳이 될 것입니다.\n  </div>\n  <div style=\"font-size:12px;color:#6b7280;margin-top:14px;text-align:right;font-style:italic;\">— Dr. K</div>\n</div>\n\n<hr style=\"border:none;border-top:2px solid #f0f4f8;margin:24px 0;\">\n\n\n\n<div style=\"background:#1f2937;border-radius:12px;padding:28px 24px;margin:20px 0;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 05</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#ffffff;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid #374151;\">🎬 이번 주의 게임씬</h2>\n  <img src=\"/assets/gamescene_001.png\" width=\"100%\" style=\"border-radius:10px;display:block;max-width:552px;\" alt=\"GTPlayer 이번 주의 게임씬 — Elden Ring: Nightreign\">\n  <div style=\"font-size:12px;color:#9ca3af;margin-top:14px;line-height:1.7;\">\n    <strong style=\"color:#e5e7eb;\">Elden Ring: Nightreign</strong> — 무너져가는 세계의 끝자락에 서다.<br>\n    \"고요하지만 전투 직전의 긴장감과 다른 것이 없다. FromSoftware는 언제나 씬 하나로 모든 것을 말한다.\" — Dr. K\n  </div>\n</div>\n\n<hr style=\"border:none;border-top:2px solid #f0f4f8;margin:24px 0;\">\n\n\n\n<div style=\"padding:20px 0;\">\n  <div style=\"font-size:11px;font-weight:800;color:#10b981;text-transform:uppercase;letter-spacing:3px;margin-bottom:6px;\">Section 06</div>\n  <h2 style=\"font-size:20px;font-weight:800;color:#1f2937;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid #f0f4f8;\">📊 이번 주 차트</h2>\n\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px;\">\n    <!-- PC TOP 3 -->\n    <div style=\"border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;\">\n      <div style=\"background:#1f2937;padding:10px 14px;font-size:11px;font-weight:800;color:#ffffff;\">🖥 PC TOP 3</div>\n      <div style=\"padding:12px 14px;\">\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#f59e0b;font-weight:800;margin-right:6px;\">1</span>Elden Ring DLC <span style=\"color:#10b981;font-size:10px;\">▲NEW</span></div>\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">2</span>Path of Exile 2</div>\n        <div style=\"font-size:12px;padding:7px 0;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">3</span>Counter-Strike 2</div>\n      </div>\n    </div>\n    <!-- 콘솔 TOP 3 -->\n    <div style=\"border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;\">\n      <div style=\"background:#1f2937;padding:10px 14px;font-size:11px;font-weight:800;color:#ffffff;\">🎮 콘솔 TOP 3</div>\n      <div style=\"padding:12px 14px;\">\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#f59e0b;font-weight:800;margin-right:6px;\">1</span>Final Fantasy XVII</div>\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">2</span>God of War: Myth</div>\n        <div style=\"font-size:12px;padding:7px 0;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">3</span>Spider-Man 3</div>\n      </div>\n    </div>\n    <!-- 모바일 TOP 3 -->\n    <div style=\"border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;\">\n      <div style=\"background:#1f2937;padding:10px 14px;font-size:11px;font-weight:800;color:#ffffff;\">📱 모바일 TOP 3</div>\n      <div style=\"padding:12px 14px;\">\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#f59e0b;font-weight:800;margin-right:6px;\">1</span>Blue Protocol <span style=\"color:#10b981;font-size:10px;\">▲NEW</span></div>\n        <div style=\"font-size:12px;padding:7px 0;border-bottom:1px solid #f3f4f6;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">2</span>Genshin Impact</div>\n        <div style=\"font-size:12px;padding:7px 0;color:#111827;\"><span style=\"color:#9ca3af;font-weight:800;margin-right:6px;\">3</span>Honor of Kings</div>\n      </div>\n    </div>\n  </div>\n</div>"
  }
}